<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/rpg_card_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📜 TAMBAH QUEST BARU"
            android:textColor="@color/rpg_gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Judul Quest (mis. Belajar Math 30 Mnt)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_quest_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/rpg_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Deskripsi Quest">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_quest_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/rpg_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kategori Quest:"
            android:textColor="@color/rpg_text_primary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinner_quest_category"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rpg_card" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Link Spesialisasi (Opsional):"
            android:textColor="@color/rpg_text_primary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinner_quest_spec"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rpg_card" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tingkat Kesulitan:"
            android:textColor="@color/rpg_text_primary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinner_quest_difficulty"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_rpg_card" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Target Waktu Timer (Menit, misal: 25)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_quest_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/rpg_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_quest"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batal"
                android:textColor="@color/rpg_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_quest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/rpg_gold"
                android:text="Simpan Quest"
                android:textColor="@color/black"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
